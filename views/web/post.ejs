<!--
  Renders the article plus the comment list with Markdown bodies, masked guest
  IP and geolocation, submission error and pending-approval notices, and a
  rate-limited comment form with live character counting and an emoji picker.
  A trailing script block exposes the emoji API endpoint and length limits to
  the client script.
  @since 1.0.0
-->

<article class="article"><p class="meta"><%= formatDate(post.created_at) %> / <%= post.views %> VIEWS</p><h1><%= post.title %></h1><div class="article-body"><%- html %></div></article>
<section class="comments ac-comments">
  <h2>评论</h2>
  <% if (acCommentError) { %><p class="ac-error"><%= acCommentError %></p><% } %>
  <% if (notice) { %><p class="notice">评论已提交，等待审核。</p><% } %>
  <% comments.forEach(comment => { %>
    <% var meta = (ac && ac.meta && ac.meta[comment.id]) || null; %>
    <div class="comment ac-comment">
      <strong><%= comment.guest_name || '注册用户' %></strong>
      <% if (comment.user_id == null && meta) { %><span class="ac-ip">IP <%= meta.ip %> · <%= meta.location %></span><% } %>
      <div class="ac-comment-body"><% if (ac && ac.renderComment) { %><%- ac.renderComment(comment.content) %><% } else { %><%= comment.content %><% } %></div>
    </div>
  <% }) %>

  <form method="post" action="<%= postUrl(post) %>/comments" class="ac-comment-form">
    <% if (currentUser) { %>
      <p class="ac-as">以 <strong><%= currentUser.username %></strong> 身份评论。</p>
    <% } else { %>
      <input name="guest_name" placeholder="<%= (ac && ac.config && ac.config.requireName) ? '姓名（必填）' : '姓名' %>" class="ac-name" <%= (ac && ac.config && ac.config.requireName) ? 'required' : '' %>>
      <input name="guest_email" type="email" placeholder="邮箱（选填）" class="ac-email">
    <% } %>
    <div class="ac-editor">
      <textarea name="content" id="ac-comment-content" required placeholder="写下你的评论，支持 Markdown 语法…" class="ac-textarea"></textarea>
      <div class="ac-toolbar">
        <button type="button" class="ac-emoji-btn" id="ac-emoji-btn" title="表情"><span>☺</span> 表情</button>
        <span class="ac-toolbar-right"><span class="ac-md-hint">M↓ Supported</span><span class="ac-char-count" id="ac-char-count">0/<%= ac ? ac.config.maxLength : 300 %></span></span>
      </div>
    </div>
    <button class="button" type="submit">提交评论</button>
  </form>
</section>

<script>window.__AC_EMOJI_API__ = "<%= ac ? ac.api : '' %>";window.__AC_MAXLEN__ = <%= ac ? ac.config.maxLength : 300 %>;window.__AC_EMOJI_ENABLED__ = <%= ac && ac.emojiEnabled ? 'true' : 'false' %>;</script>
